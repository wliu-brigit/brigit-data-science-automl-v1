# GCP project that owns the GCS bucket.
GCP_PROJECT=

# GCS bucket + top-level prefix for AutoML artifacts. The framework writes to
# gs://${GCS_BUCKET}/${GCS_PREFIX}/<project_name>/<experiment_id>/...
# These are cross-project — the same bucket/prefix is used by every project on
# this machine.
GCS_BUCKET=
GCS_PREFIX=automl

# Local MLflow tracking server. Start the bundled one with `mlflow_local start`;
# the default URI is http://127.0.0.1:54321. For a shared/team MLflow, set this
# to the team URL.
MLFLOW_TRACKING_URI=http://127.0.0.1:54321

# MLflow basic-auth credentials. Local MLflow has no auth but the client
# requires some value; for a shared server, use your team-issued credentials.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

## OPTIONAL: Kaggle API token for the Example Home Credit full-data helper.
# Kaggle API token for the Example Home Credit full-data helper. Create a
# token in Kaggle account settings, paste the KGAT_... value in `.env`, and
# accept the `home-credit-default-risk` competition rules before running:
# `uv run --script projects/example_homecredit/prepare_full_homecredit_gcs.py`.
KAGGLE_API_TOKEN=

## OPTIONAL: Snowflake credentials — needed only when the active project's
# DATA.source is a SnowflakeSource. Reaching the warehouse requires the VPN.
# `uv run automl validate project` runs a live connection probe for
# Snowflake-backed projects and lists any missing variable by name.

# Account identifier, user, and password — all three REQUIRED to connect
# (the harness errors loudly naming whichever are missing). The account
# identifier is the piece of your Snowflake URL before
# `.snowflakecomputing.com` — either the `<orgname>-<accountname>` form or a
# legacy locator like `xy12345.us-east-1`.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# OPTIONAL: compute warehouse + role for the session. Leave as-is (or blank)
# to use the data-science defaults shown below.
SNOWFLAKE_WAREHOUSE=DATA_SCIENCE_WH
SNOWFLAKE_ROLE=DATA_SCIENCE_ROLE

# Database + schema the harness works in: they fill the {database}.{schema}
# placeholders in the project's SQL files (data/queries/base_table.sql,
# training_data.sql), and the harness-built base table lands at
# {database}.{schema}.{base_table}. Use a sandbox/dev schema you can create
# tables in — never a production schema.
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
